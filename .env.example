# Copy to .env and adjust. .env is git-ignored.

# App
APP_PUBLISH_PORT=8080
LOG_LEVEL=info
ENVIRONMENT=development

# Grafana admin (required by docker-compose.monitoring.yml)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# Keep Grafana on 127.0.0.1 on a public server (Docker ports bypass UFW)
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000

# Run app + monitoring with a plain `docker compose up -d`
# COMPOSE_FILE=docker-compose.yml:docker-compose.monitoring.yml
