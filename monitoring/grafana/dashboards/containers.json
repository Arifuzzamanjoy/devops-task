              {
                "color": "red",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"$container\", name!=\"\"})\n/ (max by (name) (container_spec_memory_limit_bytes{name=~\"$container\", name!=\"\"}) > 0)",
          "legendFormat": "{{ name }}"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "reduceOptions": {
